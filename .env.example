# Copy to .env at the repository root and replace every placeholder.
POSTGRES_USER=your_db_user
POSTGRES_DB=your_db_name
POSTGRES_PASSWORD=replace-with-a-strong-random-password
# Optional for native API development (Compose exposes Postgres here):
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5434

# Required only for login/protected routes; no usable default is shipped.
# Generate a random server-only secret, e.g. `openssl rand -hex 32`.
# Must be at least 32 UTF-8 bytes. Never expose it to the frontend.
AUTH_JWT_SECRET=

# Required for all auth routes. Exact browser Origin (scheme, host, optional port),
# no trailing slash. HTTPS sets Secure cookies; HTTP is accepted only for an
# explicitly configured loopback origin (localhost, 127.0.0.1, or ::1).
# Example for native local development: http://localhost:5173
AUTH_TRUSTED_ORIGIN=
# Public cookie path: /auth for direct API, /api/auth behind an /api prefix.
AUTH_COOKIE_PATH=/auth

# ADR-025 owner-only loopback preview: explicit opt-in, never sent to Vite.
INTEGRATION_PREVIEW_ENABLED=false
# INTEGRATION_PREVIEW_OWNER_ID=<provisioned-owner-uuid>
# Crypto settings INTEGRATION_KEYRING / INTEGRATION_WRITE_KEY_ID are process-env
# only. Never put real encryption material here or in root .env; use the approved
# outside-repository key-file launcher (docs/integration-key-encryption.md).
